<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.unfurl.foundry.substrate</groupId>
    <artifactId>unfurl-foundry-substrate</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>unfurl-foundry-substrate</name>
    <description>Coordinated Java AI/agent substrate artifacts for Unfurl runtime products.</description>

    <modules>
        <module>foundry-substrate-domain</module>
        <module>foundry-substrate-events</module>
        <module>foundry-substrate-ports</module>
        <module>foundry-substrate-prompt</module>
        <module>foundry-substrate-tools</module>
        <module>foundry-substrate-rag</module>
        <module>foundry-substrate-resolver</module>
        <module>foundry-substrate-serialization</module>
        <module>foundry-substrate-offers</module>
        <module>foundry-substrate-engine</module>
        <module>foundry-substrate-testing</module>
        <!-- Sample agent claims (resource-only JARs shipping
             META-INF/unfurl-catalog.yaml). Demonstrate plug-and-play
             substrate selection: chatbot pulls in only the engine,
             research adds rag, tool-using adds tools. -->
        <module>sample-chatbot-agent</module>
        <module>sample-research-agent</module>
        <module>sample-tool-using-agent</module>
        <!-- Spring AI adapter: implements foundry's ModelProvider /
             EmbeddingProvider / VectorStore ports by wrapping
             host-supplied Spring AI beans (ChatModel / EmbeddingModel /
             VectorStore). Lets foundry consume any Spring AI provider
             via its own port abstractions without dropping the
             provider-agnostic interface. -->
        <module>foundry-substrate-springai-adapter</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <substrate.version>0.1.0-SNAPSHOT</substrate.version>
        <dcp.version>0.1.0-SNAPSHOT</dcp.version>
        <jackson.version>2.17.2</jackson.version>
        <junit.version>5.10.3</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <archunit.version>1.3.0</archunit.version>
        <jqwik.version>1.9.0</jqwik.version>
        <jakarta.validation.version>3.1.0</jakarta.validation.version>
        <spring.ai.version>1.0.0</spring.ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- foundry-substrate modules -->
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-ports</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-prompt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-rag</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-resolver</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-serialization</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-offers</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-testing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.foundry.substrate</groupId>
                <artifactId>foundry-substrate-springai-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring AI BOM. Pins all spring-ai-* artifact versions so
                 sub-modules only ever ask for the group + artifact, never
                 the version. The adapter module is the only consumer
                 today; BOM lives here so future foundry-substrate sub-modules
                 that want Spring AI types stay consistent. -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring.ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- upstream substrate (the deterministic peer layer) -->
            <dependency>
                <groupId>com.unfurl.substrate</groupId>
                <artifactId>substrate-domain</artifactId>
                <version>${substrate.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.substrate</groupId>
                <artifactId>substrate-events</artifactId>
                <version>${substrate.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.substrate</groupId>
                <artifactId>substrate-ports</artifactId>
                <version>${substrate.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.substrate</groupId>
                <artifactId>substrate-resolver</artifactId>
                <version>${substrate.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.substrate</groupId>
                <artifactId>substrate-composition-api</artifactId>
                <version>${substrate.version}</version>
            </dependency>
            <dependency>
                <groupId>com.unfurl.dcp</groupId>
                <artifactId>unfurl-dcp</artifactId>
                <version>${dcp.version}</version>
            </dependency>

            <!-- external -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>${jakarta.validation.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
